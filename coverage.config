<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet-coverage settings: coverage of the product code only; the WPF views and the tests themselves are not measured. -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <Source>.*\\tests\\.*</Source>
        <Source>.*\\OhMyPi\.VisualStudio\.UI\\Views\\.*</Source>
        <Source>.*\.xaml\.cs$</Source>
        <Source>.*\\obj\\.*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
