  <Commands package="guidOmpPackage">
    <Menus>
      <Menu guid="guidOmpCommandSet" id="OmpSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidOmpCommandSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>oh-my-pi</ButtonText>
          <CommandName>oh-my-pi</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidOmpCommandSet" id="ToolWindowToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>oh-my-pi</ButtonText>
          <CommandName>oh-my-pi</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidOmpCommandSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
