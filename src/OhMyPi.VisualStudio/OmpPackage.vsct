        <Strings>
          <ButtonText>New Session</ButtonText>
          <CanonicalName>.OMP.NewSession</CanonicalName>
          <LocCanonicalName>.OMP.NewSession</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidOmpCommandSet" id="cmdidResumeSession" priority="0x0300" type="Button">
        <Parent guid="guidOmpCommandSet" id="SessionGroup" />
        <Icon guid="ImageCatalogGuid" id="History" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Resume Session...</ButtonText>
          <ToolTipText>Session History</ToolTipText>
          <CanonicalName>.OMP.ResumeSession</CanonicalName>
          <LocCanonicalName>.OMP.ResumeSession</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidOmpCommandSet" id="cmdidRenameSession" priority="0x0400" type="Button">
