<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:OhMyPi.VisualStudio.UI.Views">

    <FontFamily x:Key="Omp.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Omp.MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="Omp.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Margin="1" Background="{DynamicResource {x:Static v:ThemeKeys.ScrollThumb}}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ScrollThumbHover}}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ScrollThumbPressed}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scroll bars (thumb only, no arrows) for every scrollable area in the panel. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Omp.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Omp.ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Omp.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Omp.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Omp.ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Omp.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Omp.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" RadiusX="3" RadiusY="3" StrokeThickness="1"
                               Stroke="{DynamicResource {x:Static v:ThemeKeys.FocusVisual}}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ToolTipBackground}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.ToolTipText}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.ToolTipBorder}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static v:ThemeKeys.FontFamily}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static v:ThemeKeys.FontSize}}" />
    </Style>

    <!-- Flat toolbar button: transparent until hovered. -->
    <Style x:Key="Omp.Button" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Foreground}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Omp.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.Hover}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.IconButton" TargetType="ButtonBase" BasedOn="{StaticResource Omp.Button}">
        <Setter Property="FontFamily" Value="{StaticResource Omp.IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Omp.ToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource Omp.IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Link}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.Hover}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Omp.SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonText}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonBorder}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Omp.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonHover}}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonHoverBorder}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonHoverText}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonPressed}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonPressedText}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonDisabled}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonDisabledText}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Omp.SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonDefaultText}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonDefault}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.ButtonDefaultBorder}}" />
    </Style>

    <Style x:Key="Omp.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Link}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Omp.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.LinkHover}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-width row button used by lists (agents, changes, recent sessions, select options). -->
    <Style x:Key="Omp.RowButton" TargetType="ButtonBase" BasedOn="{StaticResource Omp.Button}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style x:Key="Omp.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.InputText}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputBorder}}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputText}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static v:ThemeKeys.Accent}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputBorderFocused}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.InputText}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputBorder}}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputText}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputBorderFocused}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only selectable text that looks like a text block (tool output, code). -->
    <Style x:Key="Omp.ReadOnlyText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Foreground}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static v:ThemeKeys.Accent}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Omp.MonoFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Omp.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only selectable prose (messages, thinking, notices): reads like a text block, selects like a document. -->
    <Style x:Key="Omp.Prose" TargetType="RichTextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsDocumentEnabled" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Foreground}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static v:ThemeKeys.Accent}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Foreground}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Omp.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                                Background="{DynamicResource {x:Static v:ThemeKeys.CheckBoxBackground}}"
                                BorderBrush="{DynamicResource {x:Static v:ThemeKeys.CheckBoxBorder}}">
                            <TextBlock x:Name="Glyph" Text="&#xE73E;" FontFamily="{StaticResource Omp.IconFont}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource {x:Static v:ThemeKeys.CheckBoxGlyph}}" />
                        </Border>
                        <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.InputBorderFocused}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Foreground}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Omp.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Ellipse x:Name="Ring" StrokeThickness="1" Fill="{DynamicResource {x:Static v:ThemeKeys.CheckBoxBackground}}"
                                     Stroke="{DynamicResource {x:Static v:ThemeKeys.CheckBoxBorder}}" />
                            <Ellipse x:Name="Dot" Width="6" Height="6" Visibility="Collapsed" Fill="{DynamicResource {x:Static v:ThemeKeys.CheckBoxGlyph}}" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="6,0,0,0" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource {x:Static v:ThemeKeys.InputBorderFocused}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.MultiCheckBox" TargetType="CheckBox" BasedOn="{StaticResource Omp.CheckBox}">
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style x:Key="Omp.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.PopupText}}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="AccentLayer" CornerRadius="4" Opacity="0.18" Visibility="Collapsed"
                                Background="{DynamicResource {x:Static v:ThemeKeys.Accent}}" />
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AccentLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AccentLayer" Property="Opacity" Value="0.1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="AccentLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AccentLayer" Property="Opacity" Value="0.18" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.Muted}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Omp.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.PopupText}}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Omp.ListBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    </Style>

    <Style x:Key="Omp.PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.PopupBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.PopupBorder}}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static v:ThemeKeys.PopupText}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="Omp.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.Card}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static v:ThemeKeys.CardBorder}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Multi-line tool results (output, JSON, diffs): set apart from the transcript by the card background alone. -->
    <Style x:Key="Omp.CodeBlock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static v:ThemeKeys.Card}}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6,10,6" />
    </Style>

    <!-- Section and collapsible headers: chevron + content, full width, no hover fill. -->
    <Style x:Key="Omp.ExpanderHeader" TargetType="ToggleButton" BasedOn="{StaticResource Omp.Button}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The transcript: pixel-scrolled virtualizing list. -->
    <Style x:Key="Omp.Transcript" TargetType="v:TranscriptItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="v:TranscriptItemsControl">
                    <!-- Focusable so a keyboard user can page through the conversation (PageUp/PageDown, Home/End). -->
                    <ScrollViewer x:Name="PART_Scroller" Focusable="True" IsTabStop="True" CanContentScroll="True" Padding="12,8,12,12"
                                  FocusVisualStyle="{StaticResource Omp.FocusVisual}" AutomationProperties.Name="Conversation"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
