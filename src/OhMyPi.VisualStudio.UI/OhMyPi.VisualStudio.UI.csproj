<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>OhMyPi.VisualStudio.UI</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF library that uses only VS theme keys from the VS SDK (no VSSDK services); it marshals service events with Dispatcher.InvokeAsync, not JoinableTaskFactory. -->
    <NoWarn>$(NoWarn);VSTHRD001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omp.Core\Omp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OhMyPi.VisualStudio.UI.Tests" />
  </ItemGroup>

</Project>
